{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surpatagonian.local/schemas/alq-f1a-apply-transcript.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin", "tool", "target_ref", "migration_name", "query_sha256", "source_sha256", "run_id", "captured_utc", "invocation_id", "result_class", "raw_response", "raw_response_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "origin": {"const": "MCP_TRANSCRIPT_COPIED_BY_CODEX"},
    "tool": {"const": "apply_migration"},
    "target_ref": {"const": "rsjwqmpseknvydistgfr"},
    "migration_name": {"const": "alq_f1a_guardas_financieras_y_metodo"},
    "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "captured_utc": {"type": "string", "format": "date-time"},
    "invocation_id": {"type": "string", "minLength": 8},
    "result_class": {"enum": ["SUCCESS_CONFIRMED", "ERROR_DEFINITE", "RESULT_UNKNOWN"]},
    "raw_response": {},
    "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
