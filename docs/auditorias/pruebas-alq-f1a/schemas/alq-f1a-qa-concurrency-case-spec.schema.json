{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surpatagonian.local/schemas/alq-f1a-qa-concurrency-case-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_ref", "production_ref_denied", "source_sha256", "run_id", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "target_ref": {"const": "rsjwqmpseknvydistgfr"},
    "production_ref_denied": {"const": "wajkfydxutptcvvfwrvq"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "query_a", "query_b", "expected_status_a", "expected_status_b", "expected_financial_successes"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z0-9_]{3,64}$"},
          "query_a": {"type": "string", "minLength": 1, "maxLength": 4194304},
          "query_b": {"type": "string", "minLength": 1, "maxLength": 4194304},
          "expected_status_a": {"type": "string", "minLength": 1},
          "expected_status_b": {"type": "string", "minLength": 1},
          "expected_financial_successes": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
