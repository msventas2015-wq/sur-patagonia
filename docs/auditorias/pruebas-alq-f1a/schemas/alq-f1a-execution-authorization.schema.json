{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surpatagonian.local/schemas/alq-f1a-execution-authorization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "target_ref", "production_ref_denied", "bundle_lock_sha256", "publication_receipt_sha256", "connector_attestation_sha256", "source_sha256", "coordinator_sha256", "ack", "issuer", "issued_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "ALQ_F1A_EXECUTION_AUTHORIZED"},
    "target_ref": {"const": "rsjwqmpseknvydistgfr"},
    "production_ref_denied": {"const": "wajkfydxutptcvvfwrvq"},
    "bundle_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "connector_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ack": {"type": "string", "pattern": "^AUTORIZO_ALQ_F1A_"},
    "issuer": {"const": "MARIANO"},
    "issued_utc": {"type": "string", "format": "date-time"}
  }
}
