{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surpatagonian.local/schemas/alq-f1a-connector-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "target_ref", "project_scoped", "account_wide_tools_present", "tool_schemas_accept_project_id", "required_tools_present", "project_id_accepting_tool_schemas", "connector_config_sha256", "tool_catalog_sha256", "captured_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "ALQ_F1A_MCP_PROJECT_SCOPED_ATTESTED"},
    "target_ref": {"const": "rsjwqmpseknvydistgfr"},
    "project_scoped": {"const": true},
    "account_wide_tools_present": {"const": false},
    "tool_schemas_accept_project_id": {"const": false},
    "required_tools_present": {"const": ["apply_migration", "execute_sql", "list_migrations"]},
    "project_id_accepting_tool_schemas": {"const": []},
    "connector_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captured_utc": {"type": "string", "format": "date-time"}
  }
}
