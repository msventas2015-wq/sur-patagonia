{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surpatagonian.local/schemas/alq-f1a-publication-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "target_ref", "production_ref_denied", "bundle_lock_sha256", "source_path", "source_sha256", "commit_sha", "artifacts", "audit_report_path", "audit_report_sha256", "issued_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "ALQ_F1A_CLOUD_PUBLICATION_PASS"},
    "target_ref": {"const": "rsjwqmpseknvydistgfr"},
    "production_ref_denied": {"const": "wajkfydxutptcvvfwrvq"},
    "bundle_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_path": {"const": "supabase/migrations/_sources/alq_f1a_guardas_financieras_y_metodo.sql"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "audit_report_path": {"type": "string", "pattern": "^docs/auditorias/.*\\.md$"},
    "audit_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_utc": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 52,
      "maxItems": 52,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "blob_sha"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
        }
      }
    }
  }
}
