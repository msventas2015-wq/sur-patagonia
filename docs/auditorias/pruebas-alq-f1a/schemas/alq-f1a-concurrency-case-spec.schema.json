{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surpatagonian.local/schemas/alq-f1a-concurrency-case-spec.schema.json",
  "title": "ALQ F1-A local concurrency cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "session_a_sql", "session_b_sql", "expected_status_a", "expected_status_b", "expected_financial_successes"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z0-9_]{3,64}$"},
          "session_a_sql": {"type": "string", "minLength": 1, "maxLength": 4194304},
          "session_b_sql": {"type": "string", "minLength": 1, "maxLength": 4194304},
          "expected_status_a": {"type": "string", "minLength": 1},
          "expected_status_b": {"type": "string", "minLength": 1},
          "expected_financial_successes": {"type": "integer", "minimum": 0, "maximum": 1},
          "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 120}
        }
      }
    }
  }
}
